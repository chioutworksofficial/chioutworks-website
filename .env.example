# Template only: names, no values. Copy to .env and fill in. Never commit .env.
ADMIN_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=
ABUSE_SALT=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
CRON_SECRET=
# Allowed browser origins for the API, comma-separated (set when the domain is ready; Vercel hosts are added automatically)
PUBLIC_ORIGIN=

# Optional overrides (defaults live in the code):
# GROQ_MODEL, GROQ_FALLBACK_MODEL, GEMINI_LIVE_MODEL, GEMINI_LIVE_VOICE, GEMINI_LIVE_MAX_CONCURRENT,
# GEMINI_LIVE_DAILY_CAP, GEMINI_LIVE_MONTHLY_CAP, GEMINI_LIVE_BROWSER_MAX_LOW, GEMINI_LIVE_PRESSURE_PCT,
# ABUSE_TEXT_SESSION_MAX, ABUSE_TEXT_IP_DAY_MAX, ABUSE_PER_MIN, ABUSE_IP_PER_MIN, ABUSE_GLOBAL_DAY_MAX,
# ABUSE_FIRST_PAUSE_MIN, ABUSE_ALLOW_IPS, ABUSE_TEST
# E-mail sender/recipient once the domain is verified: DEMO_EMAIL_FROM, QUOTE_NOTIFY_EMAIL
# Error monitoring (optional, EU region). Both empty = off. The web DSN is public by design and is served by /api/public-config at runtime, never at build time.
SENTRY_DSN_WEB=
SENTRY_DSN_API=

# fal.ai (promo video generation, tanitim/ only)
FAL_KEY=

# Admin LLM layer (server/llm.ts): groq (default) | openai. OpenAI needs a privacy-policy entry first (context/GUVENLIK.md).
LLM_PROVIDER=groq
OPENAI_API_KEY=
OPENAI_MODEL=

# Voice Agent: key that encrypts the stored Retell API key (AES-256-GCM). If empty it is derived from ADMIN_TOKEN (works out of the box;
# changing ADMIN_TOKEN then makes the stored key unreadable, so set this once and keep it).
SETTINGS_ENC_KEY=
