# ─────────────────────────────────────────────────────────────
# Chioutworks — gizli anahtarlar (ASLA paylaşma / yükleme)
# Değeri "=
#   bash scripts/set-key.sh ANAHTAR_ADI
# Değişiklikten sonra sunucuyu yeniden başlat.
# ─────────────────────────────────────────────────────────────

# 1) Yönetici paneli şifresi (/admin)
ADMIN_TOKEN=

# 2) Sesli asistan — Google Gemini Live (aistudio.google.com/apikey)
GEMINI_API_KEY=
#    İsteğe bağlı: kullanılacak Live modeli (boş =
GEMINI_LIVE_MODEL=
#    Live-Sprachassistent (alle optional)
#    GEMINI_LIVE_VOICE: Stimme (Standard Sulafat) | GEMINI_LIVE_MAX_CONCURRENT: gleichzeitige Gespräche (3)
#    GEMINI_LIVE_DAILY_CAP: Gespräche pro Tag (60) | GEMINI_LIVE_MONTHLY_CAP: pro Monat (500)
GEMINI_LIVE_VOICE=
GEMINI_LIVE_MAX_CONCURRENT=
GEMINI_LIVE_DAILY_CAP=
GEMINI_LIVE_MONTHLY_CAP=

# 3) Yedek asistan (Gemini kotası dolarsa) + yazılı sohbet — Groq (console.groq.com/keys)
GROQ_API_KEY=
#    İsteğe bağlı model ayarları (boş =
GROQ_MODEL=
GROQ_FALLBACK_MODEL=

# 4) E-posta gönderme — Resend (alan adı alınınca tamamlanacak)
RESEND_API_KEY=
#    Gönderen adres (alan adına bağlı olmalı, ör. bildirim@alanadi.com)
DEMO_EMAIL_FROM=
#    Yeni taleplerin bildirileceği adres (sitede görünmez)
QUOTE_NOTIFY_EMAIL=

# Supabase (server only). Project Settings -> API Keys -> Secret key (sb_secret_...). Never a personal access token (sbp_...).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
